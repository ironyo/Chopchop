  m_Script: {fileID: 11500000, guid: 256d8321c611c054bbeeb3c3416c1b44, type: 3}
  m_Name: InvasionDialog
  m_EditorClassIdentifier: 
  name: "\uC6B0\uC790\uCE74\uCC28 \uC12C\uC758 \uD0B9"
  explain:
  - "\uC548\uB155\uD558\uC2E0\uAC00, {NAME} \uC12C\uC758 \uC655\uC774\uC2DC\uC5EC!\n{RANDOM}
    \uC12C\uC758 \uC655\uC785\uB2C8\uB2E4."
  - "\uC800\uB294 \uC2E0\uD558\uB4E4\uC758 \uACC4\uC18D\uB418\uB294 \uC694\uCCAD\uC5D0
    \uC5B4\uCA54 \uC218 \uC5C6\uC774 \uADC0\uD558\uC758 \uC12C\uC744\n\uCE68\uB7B5\uD558\uAC8C
    \uB418\uC5C8\uC9C0\uB9CC, \uC800\uB294 \uADC0\uD558\uC640 \uD611\uC0C1\uC744
    \uC9C4\uD589\uD558\uACE0\uC790 \uD569\uB2C8\uB2E4."
  - "\uD611\uC0C1\uC5D0 \uC751\uD560 \uC2DC {RESOURCE} {COUNT}\uAC1C\uB97C \uBC14\uCE58\uC2DC\uBA74
    \uB429\uB2C8\uB2E4.\n\uADF8\uB7FC \uC800\uD76C\uB294 \uC21C\uC21C\uD788 \uBB3C\uB7EC\uB098\uB3C4\uB85D
    \uD558\uACA0\uC2B5\uB2C8\uB2E4. "
  - "\uD611\uC0C1\uC5D0 \uC751\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C? ({WAIT})"
  - "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uD589\uC6B4\uC744 \uBE4C\uC5B4\uC694!"
  - "\uADF8\uB7FC \uC544\uC27D\uAD70\uC694. \uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4."
