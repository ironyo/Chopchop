  m_text: "\uC624\uB298\uB3C4 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4! \uBCF4\uACE0\uB4DC\uB9BD\uB2C8\uB2E4.\n\uBBF8\uB2C8\uC5B8\uB4E4\uC758
